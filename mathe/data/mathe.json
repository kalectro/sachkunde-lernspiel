            {"id": "m_l2_01", "type": "mc", "diff": 1, "q": "4 · 5 ist die HÄLFTE von …?", "options": ["4 · 10", "4 · 2", "2 · 5", "8 · 5"], "correct": 0, "explanation": "4·5 = 20 und 4·10 = 40. Die Hälfte von 40 ist 20! ✓"},
            {"id": "m_l2_02", "type": "mc", "diff": 1, "q": "3 · 10 ist das DOPPELTE von …?", "options": ["3 · 5", "3 · 2", "1 · 10", "6 · 5"], "correct": 0, "explanation": "3·10 = 30 und 3·5 = 15. Das Doppelte von 15 ist 30! ✓"},
            {"id": "m_l2_03", "type": "tf", "diff": 1, "q": "2 · 5 hat das gleiche Ergebnis wie 5 · 2.", "correct": true, "explanation": "Richtig! Das ist die Tauschaufgabe — die Reihenfolge ist egal. Beide = 10!"},
            {"id": "m_l2_04", "type": "tf", "diff": 1, "q": "6 · 5 ist die Hälfte von 6 · 10.", "correct": true, "explanation": "Richtig! 6·10 = 60, halbiert: 30. Und 6·5 = 30! ✓"},
            {"id": "m_l2_05", "type": "mc", "diff": 2, "q": "Welche Aufgabe hat das GLEICHE Ergebnis wie 7 · 2?", "options": ["2 · 7", "7 · 5", "2 · 10", "7 + 2"], "correct": 0, "explanation": "Tauschaufgabe: 7·2 = 2·7 = 14!"},
            {"id": "m_l2_06", "type": "mc", "diff": 2, "q": "Das DOPPELTE von 4 · 5 ist…?", "options": ["4 · 10", "8 · 5", "4 · 5 · 2", "Alle drei!"], "correct": 3, "explanation": "Alle drei stimmen! 4·5=20, doppelt =40. Und 4·10=40, 8·5=40, 4·5·2=40."},
            {"id": "m_l2_07", "type": "tf", "diff": 2, "q": "Wenn 3 · 5 = 15, dann ist 6 · 5 = 30.", "correct": true, "explanation": "Richtig! Doppelt so viele Päckchen → doppeltes Ergebnis. 3·5=15 → 6·5=30."},
            {"id": "m_l2_08", "type": "tf", "diff": 2, "q": "Wenn 2 · 10 = 20, dann ist 1 · 10 die Hälfte davon, also 10.", "correct": true, "explanation": "Richtig! Hälfte der Päckchen → halbiertes Ergebnis. ✓"},
            {"id": "m_l2_09", "type": "mc", "diff": 2, "q": "8 · 5 ist die Hälfte von …?", "options": ["8 · 10", "4 · 5", "16 · 5", "8 · 2"], "correct": 0, "explanation": "8·5 = 40 und 8·10 = 80. Halb von 80 = 40! ✓"},
            {"id": "m_l2_10", "type": "mc", "diff": 3, "q": "Welche Aufgabe ist das DOPPELTE von 5 · 5?", "options": ["10 · 5", "5 · 10", "5 · 5 + 5 · 5", "Alle drei!"], "correct": 3, "explanation": "Alle drei = 50! 5·5 = 25, das Doppelte = 50."},
            {"id": "m_l2_11", "type": "tf", "diff": 3, "q": "5 · 2 ist das Doppelte von 5 · 1.", "correct": true, "explanation": "Richtig! 5·1=5, doppelt =10. Und 5·2=10. ✓"},
            {"id": "m_l2_12", "type": "tf", "diff": 3, "q": "10 · 4 ist die Hälfte von 5 · 8.", "correct": false, "explanation": "Falsch! 10·4 = 40 und 5·8 = 40. Sie sind GLEICH, nicht halb so groß."},
            {"id": "m_l2_b1", "type": "mc", "diff": 3, "bonus": true, "q": "4 · 5 = 20. Wie groß ist dann 4 · 6?", "options": ["24 (= 20 + 4)", "26", "20 + 6", "30"], "correct": 0, "explanation": "Bonus! Wenn 4·5=20, dann ist 4·6 = 4·5 + 4 = 20+4 = 24!", "hint": "4·6 hat EINE Vierer-Gruppe mehr als 4·5."}
